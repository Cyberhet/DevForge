# Firebase Admin SDK — server-side Firestore access.
# Get these from Firebase Console > Project Settings > Service Accounts > Generate new private key.
# Not needed by the public site.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# GitHub OAuth — used for member sign-in via GitHub.
# Create an OAuth App at github.com/settings/developers.
# Not needed by the public site.
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret

# GitHub personal access token — fetches repo/PR stats for dashboards.
# Generate at github.com/settings/tokens.
# Not needed by the public site.
GITHUB_TOKEN=your-github-personal-access-token

# Signs and verifies session tokens.
# Generate any long random string yourself.
# Not needed by the public site.
JWT_SECRET=your-random-jwt-secret

# Web Push (VAPID) key pair — required for browser push notifications.
# Generate with `npx web-push generate-vapid-keys`.
# The public key IS needed by the public site (exposed via NEXT_PUBLIC_); the private key and subject are not.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com

# Validates requests to the event RSVP endpoint.
# Generate any long random string yourself.
# Not needed by the public site.
RSVP_API_SECRET=your-rsvp-api-secret

# SMTP — sends onboarding and orientation emails.
# Get these from your email provider (e.g. Gmail App Passwords, SendGrid).
# Not needed by the public site.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM="DevForge <no-reply@devforge.club>"

# Base URL used by integration/e2e tests to know which server to hit.
# Not needed by the public site.
TEST_BASE_URL=http://localhost:3000

# Standard Node.js environment flag (development/production/test).
# Set automatically by Next.js/npm scripts — you usually don't need to set this yourself.
# Not needed by the public site.
NODE_ENV=development
